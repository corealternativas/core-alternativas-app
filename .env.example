# --- Backend (Express) ---

# Postgres connection.
# Local dev: postgres://postgres:postgres@localhost:5432/core_alternativas
# Railway:   use the DATABASE_URL from your Railway Postgres plugin
DATABASE_URL=

# Backend port. The Vite dev proxy in vite.config.ts forwards /api to :3001.
PORT=3001

# --- Seed users (only used on first boot, if the accounts don't exist yet) ---
SEED_ADMIN_EMAIL=admin@core.local
SEED_ADMIN_PASSWORD=change-me
SEED_USER_EMAIL=user@core.local
SEED_USER_PASSWORD=change-me

# --- Style Test integration (Gmail + Notion) ---
# Gmail account that sends the emails (recipients see this as the sender).
GMAIL_USER=
# App Password – NOT your normal Gmail password.
# 1) Enable 2-Step Verification: https://myaccount.google.com/security
# 2) App passwords: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Core Style Test

# Notion integration for the style test submissions log.
NOTION_TOKEN=
NOTION_DB_ID=

# --- Frontend (Vite) ---
# Optional: skip the login screen during dev by auto-logging in.
# VITE_DEV_LOGIN_EMAIL=user@core.local
# VITE_DEV_LOGIN_PASSWORD=change-me
